{
  "uid": "stand-business-overview",
  "title": "Anomaly stand / Business overview",
  "tags": [
    "anomaly-stand",
    "business"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 0.35)",
        "name": "Ground truth (injected anomalies)",
        "target": {
          "type": "tags",
          "tags": [
            "ground-truth"
          ],
          "limit": 1000,
          "matchAny": false
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": false,
        "iconColor": "orange",
        "name": "Baseline alerts firing",
        "expr": "max by (alertname) (ALERTS{alertstate=\"firing\",detector=\"baseline\"})",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "baseline detector",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_log_requests_total, route)",
          "refId": "V"
        },
        "definition": "label_values(nginx_log_requests_total, route)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Golden signals (from nginx access log)",
